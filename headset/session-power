#!/bin/sh
# Power settings for the Monado session from the "frame" object of Monado's config (docs/FRAME.md): session-power start|stop
g=/sys/class/devfreq/3d00000.gpu
setting() {
    python3 -c 'import json,sys
try: v = json.load(open(sys.argv[1])).get("frame", {}).get(sys.argv[2], sys.argv[3])
except Exception: v = sys.argv[3]
print(str(v).lower())' "$HOME/.config/monado/config_v0.json" "$1" "$2"
}
case "$1" in
start)
    [ "$(setting stop_sched_ext false)" = true ] && sudo -n systemctl stop scx.service
    ;;
stop)
    # Lifts the frame shell's GPU cap (its performance mode)
    tr ' ' '\n' < $g/available_frequencies | sort -n | tail -1 | sudo -n tee $g/max_freq > /dev/null
    sudo -n systemctl start scx.service
    ;;
esac
exit 0
