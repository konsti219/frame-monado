[Unit]
Description=Monado VR session (steamframe)
# Same shape as gamescope-session.target, so steamos-manager's logout (stopping graphical-session.target) ends it
Requires=graphical-session.target
BindsTo=graphical-session.target
After=graphical-session.target
PropagatesStopTo=graphical-session.target
# Programs on Monado (the frame shell) add themselves with WantedBy=monado.service
Wants=monado.service
